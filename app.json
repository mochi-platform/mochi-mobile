{
  "expo": {
    "name": "Mochi",
    "slug": "mochi",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mochi",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siramong.mochi"
    },
    "android": {
      "package": "com.siramong.mochi",
      "permissions": [
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "targetSdkVersion": 36,
            "compileSdkVersion": 37
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7c3aed",
          "defaultChannel": "default",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MochiResumenWidget",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "displayName": "Resumen Mochi",
              "description": "Mochi, tu frase del día y lo que sigue",
              "contentMarginsDisabled": false,
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            },
            {
              "name": "MochiRachaWidget",
              "supportedFamilies": [
                "systemSmall"
              ],
              "displayName": "Racha Mochi",
              "description": "Tu racha y tus hábitos de hoy",
              "contentMarginsDisabled": false,
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            },
            {
              "name": "MochiDuoWidget",
              "supportedFamilies": [
                "systemSmall"
              ],
              "displayName": "Duo",
              "description": "La última nota de tu pareja",
              "contentMarginsDisabled": false,
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            }
          ],
          "enableAndroid": true
        }
      ],
      [
        "react-native-health-connect"
      ],
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#fbf6ef"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Mochi usa la cámara solo para escanear el código QR de invitación de tu pareja."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1e2e3fa6-31e0-444b-b373-0ae53e0bc6cf"
      }
    }
  }
}
