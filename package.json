{
  "name": "mochi-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./scripts/fix-expo-tsconfig-shims.mjs",
    "test": "jest --runInBand",
    "lint": "eslint . --max-warnings=0 && node scripts/ui-debt.mjs",
    "ui-debt": "node scripts/ui-debt.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "types:gen": "bash scripts/gen-types.sh",
    "test:functions": "cd supabase/functions && deno test --config deno.json --no-lock ai revenuecat-webhook admob-ssv delete-account export-data unsplash-image duo-push"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~58.0.24",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.1.33",
    "@sentry/react-native": "~8.28.0",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.99.2",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "expo": "~58.0.20",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "^58.0.11",
    "expo-calendar": "^58.0.6",
    "expo-camera": "~58.0.13",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-document-picker": "^58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-font": "^58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "^58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "^58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "^58.0.4",
    "expo-notifications": "^58.1.6",
    "expo-router": "~58.0.27",
    "expo-sharing": "^58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "^58.0.24",
    "nativewind": "^4.2.3",
    "posthog-react-native": "^4.84.0",
    "react": "19.2.4",
    "react-native": "0.88.0",
    "react-native-css-interop": "^0.2.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-health-connect": "^3.5.0",
    "react-native-purchases": "^10.0.1",
    "react-native-qrcode-svg": "^6.3.34",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "^6.1.1",
    "react-native-worklets": "^0.13.1",
    "victory-native": "^41.20.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "~30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^58.0.21",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.18.18",
    "expo-module-scripts": "^55.0.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.2.4",
    "supabase": "^2.92.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native-worklets"
      ]
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@mochi/supabase/(.*)$": "<rootDir>/src/shared/lib/supabase/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  }
}
